APP_ENV=development
DATABASE_URL=postgresql+psycopg://health:health@localhost:55432/health
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:8001
APP_TIMEZONE=Europe/Zurich
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Select openai (existing default) or ollama for every AI workload.
AI_PROVIDER=openai  # ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.8:27b-q4_K_M
OLLAMA_TIMEOUT_SECONDS=600
OLLAMA_NUM_CTX=16384
OLLAMA_NUM_PREDICT=8192
OLLAMA_PLANNER_THINK=true
OLLAMA_THINK=false

# Only used when AI_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_PLANNER_MODEL=gpt-5.6-terra
OPENAI_QA_MODEL=gpt-5.6-luna
OPENAI_FOOD_LOG_MODEL=gpt-5.6-luna
OPENAI_WORKOUT_LOG_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=medium

STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_WEBHOOK_VERIFY_TOKEN=
STRAVA_WEBHOOK_SUBSCRIPTION_ID=
STRAVA_INITIAL_SYNC_DAYS=90
STRAVA_SYNC_LOOKBACK_DAYS=35
STRAVA_SYNC_INTERVAL_MINUTES=15
STRAVA_SYNC_MAX_ACTIVITIES_PER_RUN=10000

RESEND_API_KEY=
RESEND_FROM="Health Autopilot <notifications@your-verified-domain.example>"
RESEND_TO=you@example.com

SESSION_SECRET=replace-with-at-least-32-random-characters
BOOTSTRAP_EMAIL=owner@localhost
BOOTSTRAP_PASSWORD=change-me-now
EXTENSION_API_TOKEN=
