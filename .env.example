APP_ENV=development
DATABASE_URL=postgresql+psycopg://health:health@localhost:55432/health
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:8001
# Daily planning and reconciliation are due at 00:05 in this timezone; automatic emails are disabled.
APP_TIMEZONE=Europe/Zurich
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Codex uses the local macOS user's ChatGPT login, without an API key.
AI_ENABLED=true
CODEX_PLANNER_MODEL=gpt-5.6-terra
CODEX_QA_MODEL=gpt-5.6-luna
CODEX_FOOD_LOG_MODEL=gpt-5.6-luna
CODEX_WORKOUT_LOG_MODEL=gpt-5.6-luna
CODEX_REASONING_EFFORT=medium
CODEX_TIMEOUT_SECONDS=180

STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Reconnect in Settings to grant activity:write for renaming; incline editing stays local.
STRAVA_WEBHOOK_VERIFY_TOKEN=
STRAVA_WEBHOOK_SUBSCRIPTION_ID=
STRAVA_INITIAL_SYNC_DAYS=90
STRAVA_SYNC_LOOKBACK_DAYS=35
# Background polling interval; daily-page visits also sync after 10 minutes without a full sync.
STRAVA_SYNC_INTERVAL_MINUTES=15
STRAVA_SYNC_MAX_ACTIVITIES_PER_RUN=10000

# Used only by explicitly invoked email jobs; emails are not scheduled automatically.
RESEND_API_KEY=
RESEND_FROM="Health Autopilot <notifications@your-verified-domain.example>"
RESEND_TO=you@example.com

SESSION_SECRET=replace-with-at-least-32-random-characters
BOOTSTRAP_EMAIL=owner@localhost
BOOTSTRAP_PASSWORD=change-me-now
EXTENSION_API_TOKEN=
